# Copie para .env e preencha. Crie uma conta gratuita e gere uma license key em
# https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Consulta local (sem rede): caminho do .mmdb
GEO_DB=/var/lib/GeoIP/GeoLite2-Country.mmdb

# Web service gratuito GeoLite (exige as credenciais acima)
GEOLITE_WS_BASE=https://geolite.info/geoip/v2.1
# Download de bancos
MAXMIND_DOWNLOAD_BASE=https://download.maxmind.com/geoip/databases
